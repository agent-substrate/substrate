// Renovate keeps the Go toolchain that builds what we ship patched: the
// toolchain directive in the root go.mod and in each plugin module. Nothing
// else is updated. Dev-time tools under hack/tools and tools/ keep their own
// toolchain.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  // Until the first runs look right, Renovate lists updates in its dashboard
  // issue and opens a PR only when one is ticked there.
  dependencyDashboardApproval: true,
  enabledManagers: ["gomod"],
  includePaths: ["go.mod", "internal/plugins/*/go.mod"],
  baseBranchPatterns: ["main", "release-0.5"],
  semanticCommits: "disabled",
  labels: ["dependencies", "go"],
  packageRules: [
    // Off by default: no ordinary dependency updates.
    { matchPackageNames: ["*"], enabled: false },
    // Back on for the toolchain directive only; the go directive stays put.
    {
      matchDepTypes: ["toolchain"],
      matchDepNames: ["go"],
      enabled: true,
      // One PR for every module, opened as soon as Go releases.
      groupName: "Go toolchain",
      minimumReleaseAge: "0 days",
    },
    // A minor upgrade (1.28) waits for a tick in the dashboard even after
    // dependencyDashboardApproval above is removed.
    {
      matchDepTypes: ["toolchain"],
      matchUpdateTypes: ["minor", "major"],
      dependencyDashboardApproval: true,
    },
  ],
}
