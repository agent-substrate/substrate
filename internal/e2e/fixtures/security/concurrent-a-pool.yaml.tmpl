# Kubernetes half of the concurrent security fixture for atespace A: a k8s
# Namespace plus a WorkerPool with replicas: 2.
#
# Applying this manifest does not create an atespace. e2e.DeploySubstrateFixture
# creates the atespace of the same name through the ate API, from
# concurrent-template.yaml.tmpl.
#
# replicas is 2 on purpose: the test runs two actors at the exact same time
# on two distinct worker pods to verify space-invariance boundaries (NW-6,
# NW-2, ST-1 [space], EX-4 [space]). The fixture for atespace B applies
# concurrent-b-namespace.yaml.tmpl, a k8s Namespace with no pool, so the
# actors of both atespaces share this 2-worker pool.

apiVersion: v1
kind: Namespace
metadata:
  name: ate-e2e${FIXTURE_SUFFIX}
  labels:
    ate.dev/e2e: "true"

---

apiVersion: ate.dev/v1
kind: WorkerPool
metadata:
  name: concurrent
  namespace: ate-e2e${FIXTURE_SUFFIX}
  labels:
    workload: ate-e2e-concurrent
spec:
  replicas: 2
  workerImage: ${WORKER_IMAGE}
${WORKERPOOL_RUNTIME}
