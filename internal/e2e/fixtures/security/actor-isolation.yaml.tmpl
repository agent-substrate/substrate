# Single-atespace actor-isolation security fixture: a namespace plus a
# single-worker WorkerPool.
#
# replicas is 1 on purpose. The test runs a victim actor, suspends it, and
# starts an attacker actor in the same atespace. With one worker the attacker
# has to land on the worker the victim just vacated, which is where the
# victim's per-actor host state is.
apiVersion: v1
kind: Namespace
metadata:
  name: ate-e2e${FIXTURE_SUFFIX}
  labels:
    ate.dev/e2e: "true"

---

apiVersion: ate.dev/v1alpha1
kind: WorkerPool
metadata:
  name: actor
  namespace: ate-e2e${FIXTURE_SUFFIX}
  labels:
    workload: ate-e2e-actor${FIXTURE_SUFFIX}
spec:
  replicas: 1
  workerImage: ${ATEOM_IMAGE}
${WORKERPOOL_RUNTIME}
