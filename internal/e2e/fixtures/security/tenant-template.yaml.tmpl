# The tenant ActorTemplate of the cross-tenant security fixture: a
# protojson-shaped ateapipb.ActorTemplate created through the ate API by
# e2e.DeploySubstrateFixture.
#
# BOTH tenants deploy this same file. They differ only in the ${FIXTURE_SUFFIX}
# they render with, which is what gives each its own atespace and its own
# snapshot prefix, so the suite compares two tenants that are identical in
# every respect except the boundary under test.
#
# Reuses the probe image for its /readfile and /writefile endpoints: the
# storage assertions have to be made from inside the sandbox, against what the
# volume actually delivered, rather than against the config atelet generated.
#
# The workerSelector names the single shared pool (see tenant-pool.yaml.tmpl),
# not a per-tenant one.

metadata:
  atespace: ate-e2e${FIXTURE_SUFFIX}
  name: tenant
workerSelector:
  matchLabels:
    workload: ate-e2e-security
containers:
- name: probe
  image: ko://github.com/agent-substrate/substrate/internal/e2e/fixtures/probe
  command: ["/ko-app/probe"]
  volumeMounts:
  # The probe reads its own actor identity under /run/ate, which the storage
  # assertions use to tell the two tenants' actors apart from the inside.
  - name: system-info
    mountPath: /run/ate
  # The per-actor durable directory whose isolation is under test.
  - name: data
    mountPath: /data
  # Gate the golden snapshot on the probe actually serving, so a read or write
  # right after a resume cannot race a sandbox checkpointed before the
  # listener came up.
  wakeupProbe:
    httpGet:
      path: /healthz
      port: 80
    timeoutSeconds: 60
volumes:
- name: system-info
  systemInfo:
    dataSources:
    - actorMetadata:
        items:
        - field: ACTOR_METADATA_FIELD_NAME
          path: actor-id
        - field: ACTOR_METADATA_FIELD_ATESPACE
          path: atespace
        - field: ACTOR_METADATA_FIELD_UID
          path: actor-uid
- name: data
  durableDir: {}
${TEMPLATE_RESOURCES}
${TEMPLATE_SANDBOX_CONFIG}
snapshotConfig:
  storageLocation: gs://${BUCKET_NAME}/ate-e2e${FIXTURE_SUFFIX}/
