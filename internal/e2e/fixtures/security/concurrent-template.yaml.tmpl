# The ActorTemplate of the concurrent two-worker security fixture: a
# protojson-shaped ateapipb.ActorTemplate created through the ate API by
# e2e.DeploySubstrateFixture.
#
# Both atespaces deploy this same file. They differ only in the ${FIXTURE_SUFFIX}
# they render with. The workerSelector names the shared 2-replica pool.

metadata:
  atespace: ate-e2e${FIXTURE_SUFFIX}
  name: probe
workerSelector:
  matchLabels:
    workload: ate-e2e-concurrent
containers:
- name: probe
  image: ko://github.com/agent-substrate/substrate/internal/e2e/fixtures/probe
  command: ["/ko-app/probe"]
  volumeMounts:
  - name: system-info
    mountPath: /run/ate
  - name: data
    mountPath: /data
  wakeupProbe:
    httpGet:
      path: /healthz
      port: 80
    timeoutSeconds: 60
volumes:
- name: system-info
  systemInfo:
    dataSources:
    - actorMetadata:
        items:
        - field: ACTOR_METADATA_FIELD_NAME
          path: actor-id
        - field: ACTOR_METADATA_FIELD_ATESPACE
          path: atespace
        - field: ACTOR_METADATA_FIELD_UID
          path: actor-uid
- name: data
  durableDir: {}
resources:
  limits:
  - name: cpu
    quantity: "1"
  - name: memory
    quantity: 512Mi
${TEMPLATE_SANDBOX_CONFIG}
snapshotConfig:
  storageLocation: gs://${BUCKET_NAME}/ate-e2e${FIXTURE_SUFFIX}/
