# Atespace B of the cross-atespace security fixture: a namespace only.
#
# Atespace B deliberately has no WorkerPool. Pools are not scoped to an
# atespace, so B's actors are placed on the single-worker pool that
# atespace-a-pool.yaml.tmpl deploys in atespace A's namespace. That forces
# A's and B's actors to take turns on one worker, which is the reuse boundary
# the suite tests.
#
# The namespace is still needed: Substrate reconciles an atespace's
# namespaced objects (network policies, for example) into it.

apiVersion: v1
kind: Namespace
metadata:
  name: ate-e2e${FIXTURE_SUFFIX}
