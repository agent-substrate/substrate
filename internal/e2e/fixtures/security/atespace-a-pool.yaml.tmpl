# Atespace A of the cross-atespace security fixture: a namespace plus the only
# WorkerPool. Atespace B deploys atespace-b-namespace.yaml.tmpl, a namespace
# with no pool, so its actors run on this one too.
#
# Pools are not scoped to an atespace: the scheduler matches on sandbox class,
# labels and capacity, never on the actor's atespace.
#
# replicas is 1 because TestCrossAtespaceIsolation runs one actor at a time:
# the source actor in atespace A, then, once that is suspended, its clone. The
# worker-reuse checks (a victim, then an attacker on the worker it left) do
# not use this fixture. They live in TestActorIsolation, which runs both
# actors in one atespace on the single worker of actor-isolation.yaml.tmpl.
#
# The workload label is a fixed string rather than ${FIXTURE_SUFFIX}-suffixed
# because both atespaces' templates must select this one pool and they render
# with different suffixes. Sharing the label across the gVisor and micro-VM
# lanes is safe: they run one after the other, and sandbox class is itself a
# scheduling constraint.

apiVersion: v1
kind: Namespace
metadata:
  name: ate-e2e${FIXTURE_SUFFIX}

---

apiVersion: ate.dev/v1
kind: WorkerPool
metadata:
  name: shared
  namespace: ate-e2e${FIXTURE_SUFFIX}
  labels:
    workload: ate-e2e-security
spec:
  replicas: 1
  workerImage: ${WORKER_IMAGE}
${WORKERPOOL_RUNTIME}
