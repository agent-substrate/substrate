# The dnsruntimes fixture's ActorTemplates: protojson-shaped
# ateapipb.ActorTemplate documents for the glibc (Debian) and musl (Alpine)
# multi-runtime images.

metadata:
  atespace: ate-e2e${FIXTURE_SUFFIX}
  name: runtime-glibc
workerSelector:
  matchLabels:
    workload: dnsruntimes
containers:
- name: probe
  image: ${GLIBC_IMAGE}
  command: ["/usr/local/bin/dnsruntimes-agent"]
  securityContext:
    capabilities:
      add: ["SYS_ADMIN"]
  wakeupProbe:
    httpGet:
      path: /healthz
      port: 80
    timeoutSeconds: 60
resources:
  limits:
  - name: cpu
    quantity: "1"
  - name: memory
    quantity: 1Gi
${TEMPLATE_SANDBOX_CONFIG}
snapshotConfig:
  storageLocation: gs://${BUCKET_NAME}/ate-e2e-runtime-glibc${FIXTURE_SUFFIX}/

---

