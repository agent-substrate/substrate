# Probe template for multi-actor routing tests.

metadata:
  atespace: ate-e2e${FIXTURE_SUFFIX}
  name: probe-multiactor
workerSelector:
  matchLabels:
    workload: probe-multiactor
containers:
- name: probe
  image: ko://github.com/agent-substrate/substrate/internal/e2e/fixtures/probe
  command: ["/ko-app/probe"]
  volumeMounts:
  # Identity returned by /whoami.
  - name: system-info
    mountPath: /run/ate
  wakeupProbe:
    httpGet:
      path: /healthz
      port: 80
volumes:
- name: system-info
  systemInfo:
    dataSources:
    - actorMetadata:
        items:
        - field: ACTOR_METADATA_FIELD_NAME
          path: actor-id
        - field: ACTOR_METADATA_FIELD_ATESPACE
          path: atespace
        - field: ACTOR_METADATA_FIELD_UID
          path: actor-uid

# Allow multiple actors to fit on one worker.
resources:
  limits:
  - name: cpu
    quantity: "1"
  - name: memory
    quantity: 256Mi
${TEMPLATE_SANDBOX_CONFIG}
snapshotConfig:
  storageLocation: gs://${BUCKET_NAME}/ate-e2e${FIXTURE_SUFFIX}/
