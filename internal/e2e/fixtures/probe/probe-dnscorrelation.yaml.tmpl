# The probe fixture's namespace and WorkerPool, with DNS correlation on for
# the pool (see docs/guides/dns-correlation.md). The ActorTemplate is the one
# in probe-template.yaml.tmpl.
#
# Rendered by e2e.RenderFixtureManifest, as probe.yaml.tmpl is.

apiVersion: v1
kind: Namespace
metadata:
  name: ate-e2e-probe${FIXTURE_SUFFIX}
  labels:
    # Lets hack/cleanup-e2e.sh find and delete this namespace when a failed
    # test leaves the fixture behind for debugging.
    ate.dev/e2e: "true"

---

apiVersion: ate.dev/v1
kind: WorkerPool
metadata:
  name: probe
  namespace: ate-e2e-probe${FIXTURE_SUFFIX}
  labels:
    workload: probe${FIXTURE_SUFFIX}
  annotations:
    workerpool.ate.dev/dns-correlation: "true"
spec:
  replicas: 2
  workerImage: ${WORKER_IMAGE}
${WORKERPOOL_RUNTIME}
