# An ActorTemplate on the probe pool (probe.yaml.tmpl) whose image runs as a
# named non-root USER in a WORKDIR that user owns. The imagefs suite resolves
# it with `ko resolve --image-user nonroot:nonroot` (e2e.WithImageUser); the
# nonroot distroless base sets WORKDIR /home/nonroot.

metadata:
  atespace: ate-e2e-probe${FIXTURE_SUFFIX}
  name: probe-nonroot
workerSelector:
  matchLabels:
    workload: probe${FIXTURE_SUFFIX}
containers:
- name: probe
  image: ko://go.ate.dev/substrate/internal/e2e/fixtures/probe/nonroot
  command: ["/ko-app/nonroot"]
  wakeupProbe:
    httpGet:
      path: /healthz
      port: 80
    timeoutSeconds: 60
resources:
  limits:
    cpuMillicores: 1000
    memoryBytes: 536870912 # 512Mi
