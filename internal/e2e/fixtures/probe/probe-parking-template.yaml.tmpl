# Parking variant of the probe template: a protojson-shaped
# ateapipb.ActorTemplate whose limits are one whole worker's worth, so two of
# its actors cannot share the fixture's single worker. Reuses the probe image
# (it serves /whoami, which names the actor that answered).

metadata:
  atespace: ate-e2e${FIXTURE_SUFFIX}
  name: probe-parking
workerSelector:
  matchLabels:
    workload: probe-parking
containers:
- name: probe
  image: ko://github.com/agent-substrate/substrate/internal/e2e/fixtures/probe
  command: ["/ko-app/probe"]
  volumeMounts:
  - name: system-info
    mountPath: /run/ate
  wakeupProbe:
    httpGet:
      path: /healthz
      port: 80
volumes:
- name: system-info
  systemInfo:
    dataSources:
    - actorMetadata:
        items:
        - field: ACTOR_METADATA_FIELD_NAME
          path: actor-id
# One actor's worth of CPU, matching the pool's per-worker limit in
# probe-parking.yaml.tmpl: what makes the worker full after one placement.
# Quantities are strings in the proto.
resources:
  limits:
  - name: cpu
    quantity: "1"
  - name: memory
    quantity: 512Mi
${TEMPLATE_SANDBOX_CONFIG}
snapshotsConfig:
  storageLocation: gs://${BUCKET_NAME}/ate-e2e${FIXTURE_SUFFIX}/
