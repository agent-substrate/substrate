# Boot-fetch variant of the probe template: a protojson-shaped
# ateapipb.ActorTemplate whose probe fetches https://example.com/ through the
# egress gateway before it listens, so its golden snapshot exists only if the
# actor had egress while it booted. Selects the probe pool of probe.yaml.tmpl;
# the suite gives the golden actor its EgressPolicy (see
# e2e.WithGoldenEgressPolicy) and the template the trust bundle.

metadata:
  atespace: ate-e2e-probe${FIXTURE_SUFFIX}
  name: probe-bootfetch
workerSelector:
  matchLabels:
    workload: probe${FIXTURE_SUFFIX}
containers:
- name: probe
  image: ko://github.com/agent-substrate/substrate/internal/e2e/fixtures/probe
  command: ["/ko-app/probe"]
  env:
  - name: PROBE_BOOT_FETCH_URL
    value: https://example.com/
  volumeMounts:
  - name: system-info
    mountPath: /run/ate
  # Longer than the probe's own boot-fetch budget, so a failed fetch is the
  # probe's logged error rather than a probe timeout.
  wakeupProbe:
    httpGet:
      path: /healthz
      port: 80
    timeoutSeconds: 60
volumes:
- name: system-info
  systemInfo:
    dataSources:
    - actorMetadata:
        items:
        - field: ACTOR_METADATA_FIELD_NAME
          path: actor-id
${TEMPLATE_TRUST_BUNDLE}
${TEMPLATE_RESOURCES}
${TEMPLATE_SANDBOX_CONFIG}
snapshotConfig:
  storageLocation: gs://${BUCKET_NAME}/ate-e2e-probe${FIXTURE_SUFFIX}-bootfetch/
