# The k8s half of the sized probe fixture (see probe-sized-template.yaml.tmpl
# for the ActorTemplate). Kept in its own namespace so it never collides with
# the plain probe fixture.
#
# Rendered by e2e.RenderFixtureManifest, which fills the ${...} placeholders
# for the sandbox class under test.

apiVersion: v1
kind: Namespace
metadata:
  name: ate-e2e${FIXTURE_SUFFIX}

---

apiVersion: ate.dev/v1alpha1
kind: WorkerPool
metadata:
  name: probe-sized
  namespace: ate-e2e${FIXTURE_SUFFIX}
  labels:
    workload: probe-sized
spec:
  replicas: 3
  workerImage: ${ATEOM_IMAGE}
${WORKERPOOL_RUNTIME}
