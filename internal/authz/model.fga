# Global Cluster Scope
type cluster
  relations
<<<<<<< HEAD
    define admin: [user, service_account]

type atespace
  relations
    # Optional link to cluster-wide root cluster
    define parent_cluster: [cluster]

    # Standard 3-tier hierarchy: admin -> developer -> viewer
    define admin: [user, service_account] or admin from parent_cluster

    define developer: [user, service_account] or admin
    define viewer: [user, service_account] or developer

    # Action Permission: Who can create new actor instances in this atespace
    define can_create_actor: developer

type actor_template
  relations
    # Parent Container workspace where template definition lives
    define parent_atespace: [atespace]

    # Creator of this template definition
    define creator: [user, service_account]

    # Template maintainers (full update/delete control over template)
    define operator: creator or developer from parent_atespace

    # Read-only inspection of template metadata
    define viewer: operator or viewer from parent_atespace

    # Who can instantiate actors from this template (supports wildcards like user:*)
    define can_instantiate: [user, user:*, service_account, service_account:*] or viewer

type actor
  relations
    # Parent Container workspace where runtime instance lives
    define parent_atespace: [atespace]

    # Actor Template from which this instance was initialized
    define template: [actor_template]

    # Creator of this specific actor instance
    define creator: [user, service_account]

    # Full Lifecycle Control (pause, destroy, mint_token)
    define operator: creator or developer from parent_atespace

    # Control-Plane Lifecycle Wakeup: Infrastructure router service accounts OR lifecycle operators
    define can_resume: [service_account] or operator

    # Data-Plane Network Traffic Routing / Execution: End users, router proxy, or peer actors
    define can_invoke: [user, user:*, service_account, service_account:*, actor] or operator

    # Instance Inspection (metadata, status, details)
    define can_get: operator or viewer from parent_atespace

    # Instance Mutation & Destruction
    define can_update: operator
    define can_delete: operator

    # Idle Self-Suspend (operators OR self-referential actor matching)
    define can_suspend: [actor with is_self_actor] or operator


    # Protected Metadata / Label Updates
    # System labels require admin; standard labels require operator/user + label policy check
    define can_update_protected_label: admin from parent_atespace
    define can_update_standard_label: [user with is_standard_label, user:* with is_standard_label, service_account with is_standard_label, service_account:* with is_standard_label] and operator
    define can_update_label: can_update_protected_label or can_update_standard_label


# Conditions
condition is_standard_label(label_key: string) {
  !label_key.startsWith("substrate.ate.dev/") && !label_key.startsWith("security/")
}

condition is_self_actor(target_actor: string, calling_actor: string) {
  target_actor == calling_actor
}
