# Template for the gVisor (runsc) SandboxConfig each Substrate release
# installs. `ate-setup deploy sandboxconfig` and `deploy ate-system` create
# substrate-<release>-gvisor from it, and by default annotate it as the class
# default. Editing this file changes only the configs that later releases
# create, and a rerun of the same release updates its own config.
#
# atelet fetches the gVisor release tarball (gvisor.tar.zstd: runsc plus the
# gvisor-bin/ helpers runsc requires next to it) matching the worker node's
# architecture and extracts it locally.
#
# To change the sandbox, add a new version and point defaultVersion at it.
# Do not edit or remove the versions already listed. An actor restores its
# memory only on a version with the same assets as the one its snapshot was
# taken on, so dropping that version makes the actor cold boot and lose its
# memory. Remove a version only when it has a known vulnerability, or to make
# room under the limit of 16 versions.
apiVersion: ate.dev/v1
kind: SandboxConfig
metadata:
  name: ${SANDBOXCONFIG_NAME}
spec:
  sandboxClass: gvisor
  defaultVersion: gvisor-6
  versions:
  # gVisor release 20261026.0. ateworker-gvisor saves container rootfs overlays
  # (rootfs/) and durable-dir volumes (fs/) as separate checkpoint bundles. That
  # needs google/gvisor@b79256080dec, first in tagged release 20261019.0.
  # ateworker-gvisor also runs the sandbox with no root container
  # (google/gvisor#15551). This release's restore picks each container's init
  # process correctly in such a sandbox (google/gvisor@29b97c66d945).
  - name: gvisor-6
    state: Enabled
    assets:
      amd64:
        gvisor:
          url: "gs://gvisor/releases/release/20261026.0/x86_64/gvisor.tar.zstd"
          sha256: "708afc62f2ee82d19930c703e85f9dab4f27a78c0aec40c0f55eb1040107f1a7"
      arm64:
        gvisor:
          url: "gs://gvisor/releases/release/20261026.0/aarch64/gvisor.tar.zstd"
          sha256: "6257e49955f13e6caceb2c4181c5dc5406c460e805940c944e67ad65553f5b02"
