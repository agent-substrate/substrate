          sha256: "4b43f4f6de6500203b01214a790314eea4182f5f110594ddb28ae2805622f06f"
        kata-kernel:
          url: "${BUCKET_SCHEME}://${ASSET_BUCKET_NAME}/microvm-assets/arm64/daa09cde28472ee6afad203a20c94a6ce1c96c9d8dffafdd4c0e87c59262d64a"
          sha256: "daa09cde28472ee6afad203a20c94a6ce1c96c9d8dffafdd4c0e87c59262d64a"
        kata-image:
