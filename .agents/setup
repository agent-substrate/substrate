set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${repo_root}"

echo "[setup] checking system tools"
packages=()
command -v curl >/dev/null || packages+=(curl)
command -v git >/dev/null || packages+=(git)
command -v gcc >/dev/null || packages+=(build-essential)
command -v make >/dev/null || packages+=(make)
if ((${#packages[@]})); then
  sudo apt-get update -qq
  sudo apt-get install -y -qq --no-install-recommends ca-certificates "${packages[@]}"
fi

go_version="$(awk '$1 == "go" { print $2; exit }' go.mod)"
if [[ -z "${go_version}" ]]; then
  echo "[setup] go.mod does not declare a Go version" >&2
  exit 1
fi

installed_version=""
if command -v go >/dev/null; then
  installed_version="$(go env GOVERSION 2>/dev/null || true)"
fi
if [[ "${installed_version}" != "go${go_version}" ]]; then
  case "$(uname -m)" in
    x86_64) go_arch=amd64 ;;
    aarch64|arm64) go_arch=arm64 ;;
    *) echo "[setup] unsupported architecture: $(uname -m)" >&2; exit 1 ;;
  esac
  install_root="${HOME}/.local/share/go/${go_version}"
  archive="${HOME}/.cache/amp/go${go_version}.linux-${go_arch}.tar.gz"
  echo "[setup] installing Go ${go_version} for linux/${go_arch}"
  mkdir -p "$(dirname "${archive}")" "$(dirname "${install_root}")" "${HOME}/.local/bin"
  if [[ ! -s "${archive}" ]]; then
    curl --fail --location --retry 3 --output "${archive}.tmp" \
      "https://go.dev/dl/go${go_version}.linux-${go_arch}.tar.gz"
    mv "${archive}.tmp" "${archive}"
  fi
  rm -rf "${install_root}"
  mkdir -p "${install_root}"
  tar -xzf "${archive}" --strip-components=1 -C "${install_root}"
  ln -sfn "${install_root}/bin/go" "${HOME}/.local/bin/go"
  ln -sfn "${install_root}/bin/gofmt" "${HOME}/.local/bin/gofmt"
fi

export PATH="${HOME}/.local/bin:${PATH}"
echo "[setup] using $(go version)"

# The checked-in vendor tree supplies root-module dependencies without a
# network fetch. Resolve package metadata to catch a broken toolchain or vendor
# tree while leaving compilation and optional tool modules to the task that
# needs them.
echo "[setup] verifying vendored module"
go list -mod=vendor ./cmd/ateapi ./cmd/macletd >/dev/null
echo "[setup] complete"
