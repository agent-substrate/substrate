{{/*
Adds a page for each release the API reference documents, such as
docs/reference/api/v1.0.0/, from the versions.json that apitool
generate-docs writes. docs/reference/api.md is the page for latest. Release
pages stay out of the sidebar, section cards and search; the reference's
version menu links to them.
*/ -}}

{{- with resources.Get "api-reference/versions.json" -}}
  {{- range transform.Unmarshal . -}}
    {{- if ne . "latest" -}}
      {{- $.AddPage (dict
        "path" .
        "kind" "page"
        "title" (printf "API Reference (%s)" .)
        "layout" "api-reference"
        "params" (dict
          "api_version" .
          "body_class" "as-apiref-page"
          "toc_hide" true
          "hide_summary" true
          "exclude_search" true
        )
      ) -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
