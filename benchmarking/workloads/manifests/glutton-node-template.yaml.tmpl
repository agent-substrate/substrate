# ActorTemplate for glutton-node, the Node.js counterpart of the glutton
# template, created through the ate API by workloads/deploy.sh. GluttonUser
# drives it with --glutton-template glutton-node. deploy.sh builds the image
# from benchmarking/workloads/glutton-node unless GLUTTON_NODE_IMAGE is set.
metadata:
  atespace: benchmark-workloads
  name: glutton-node
workerSelector:
  matchLabels:
    workload: benchmark-worker
containers:
- name: glutton-node
  image: "${GLUTTON_NODE_IMAGE}"
  # The old space limit is the actor's memory limit, so the working set is
  # bounded by the sandbox as it is for glutton, not by V8's default.
  command:
  - "node"
  - "--max-old-space-size=${ACTOR_MEMORY_MIB}"
  - "/app/server.js"
  # Hold ResumeActor open until port 80 actually answers.
  wakeupProbe:
    httpGet:
      path: /readyz
      port: 80
resources:
  limits:
    cpuMillicores: "${ACTOR_CPU_MILLICORES}"
    memoryBytes: "${ACTOR_MEMORY_BYTES}"
snapshotConfig:
  preferredFidelity: SNAPSHOT_FIDELITY_MEMORY
