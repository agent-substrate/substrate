# Generated by benchmarking/workloads/manifests/sweperf/generate_sweperf_templates.py
# from sweperf-images.json and sweperf-template.yaml.j2; edit those, not this
# file. The ${...} values are filled in by benchmarking/workloads/deploy.sh.
metadata:
  atespace: benchmark-workloads
  name: sweperf-sphinx-8638
workerSelector:
  matchLabels:
    workload: benchmark-ateom
containers:
- name: sphinx
  # Built from https://github.com/gke-labs/sweperf c30c0d6 or later (older
  # images have no HTTP server and fail the client's first GET /status), pinned
  # by digest because these images are rebuilt in place under the same tag.
  image: "us-docker.pkg.dev/gke-substrate-release/benchmark/sweperf@sha256:ca801ef886f07f92598f576b875e6f5b5ce4d7d8ed4da607d210e7f0caa23210"
  command:
  - "python3"
  - "/replay.py"
  - "/trace.json"
  env:
  - name: SWEPERF_DISABLE_INTERNAL_SLEEP
    value: "1"
  # The trajectory's step count, for reference only: the sweperf client takes
  # it from --sweperf-total-steps, so run this template with
  # --sweperf-total-steps=64.
  - name: SWEPERF_TOTAL_STEPS
    value: "64"
sandboxConfig:
  sandboxClass: ${SANDBOX_CLASS_ENUM}
  configName: ${SANDBOX_CONFIG_NAME}
snapshotConfig:
  onCommit: SNAPSHOT_CONTENT_SCOPE_FULL
  storageLocation: gs://${BUCKET_NAME}/benchmark-workloads/sweperf-sphinx-8638/
