# ActorTemplate (protojson-shaped ateapipb.ActorTemplate) for the kernelmem
# benchmark workload (locust/tests/kernelmem.py): fills kernel memory with
# dentry cache and sleeping processes to size kernel-state snapshots. Not
# part of deploy.sh's default template set; deploy with
# WORKLOAD_TEMPLATES="kernelmem ...". No memory limit: the 50000 sleeping
# processes need more than the 256Mi default --actor-memory the other
# templates take. The sandbox class must match the WorkerPool's so snapshots
# stay within a class.
metadata:
  atespace: benchmark-workloads
  name: kernelmem
workerSelector:
  matchLabels:
    workload: benchmark-ateom
containers:
- name: kernelmem
  image: containerstack/alpine-stress:latest
  command: ["sh", "-c", "find /; for i in $(seq 50000); do sleep 10000 & done; sleep 10000"]
snapshotsConfig:
  onPause: SNAPSHOT_CONTENT_SCOPE_FULL
  onCommit: SNAPSHOT_CONTENT_SCOPE_FULL
  storageLocation: gs://${BUCKET_NAME}/benchmark-workloads/kernelmem/
sandboxConfig:
  sandboxClass: ${SANDBOX_CLASS_ENUM}
  configName: ${SANDBOX_CONFIG_NAME}
