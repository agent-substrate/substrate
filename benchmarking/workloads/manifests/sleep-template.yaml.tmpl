# ActorTemplate (protojson-shaped ateapipb.ActorTemplate) for the sleep
# benchmark workload, created through the ate API by workloads/deploy.sh.
# The sandbox class must match the WorkerPool's so snapshots stay within a
# class.
metadata:
  atespace: benchmark-workloads
  name: sleep
workerSelector:
  matchLabels:
    workload: benchmark-ateom
containers:
- name: sleep
  image: busybox@sha256:1487d0af5f52b4ba31c7e465126ee2123fe3f2305d638e7827681e7cf6c83d5e
  command: ["/bin/sleep", "1000000"]
# Without a limit a microvm actor gets the kata default 2 GiB guest, and
# anything the guest kernel caches rides along in the memory snapshot —
# bigger guest, bigger snapshot, slower suspend/resume. microvm requires at
# least 256Mi (128Mi VMM reserve + 128Mi guest floor).
resources:
  limits:
  - name: memory
    quantity: ${ACTOR_MEMORY}
snapshotsConfig:
  onPause: SNAPSHOT_CONTENT_SCOPE_FULL
  onCommit: SNAPSHOT_CONTENT_SCOPE_FULL
  storageLocation: gs://${BUCKET_NAME}/benchmark-workloads/sleep/
sandboxConfig:
  sandboxClass: ${SANDBOX_CLASS_ENUM}
  configName: ${SANDBOX_CONFIG_NAME}
