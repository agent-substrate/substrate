# ActorTemplate (protojson-shaped ateapipb.ActorTemplate) for the sleep
# benchmark workload, created through the ate API by workloads/deploy.sh.
metadata:
  atespace: benchmark-workloads
  name: sleep
workerSelector:
  matchLabels:
    workload: benchmark-worker
containers:
- name: sleep
  image: busybox@sha256:1487d0af5f52b4ba31c7e465126ee2123fe3f2305d638e7827681e7cf6c83d5e
  command: ["/bin/sleep", "1000000"]
# Keep the memory small: anything the micro-VM guest kernel caches rides
# along in the memory snapshot, so a bigger guest means slower
# suspend/resume. microvm requires at least 256Mi (128Mi VMM reserve +
# 128Mi guest floor).
resources:
  limits:
  - name: cpu
    quantity: "${ACTOR_CPU}"
  - name: memory
    quantity: "${ACTOR_MEMORY}"
snapshotConfig:
  preferredFidelity: SNAPSHOT_FIDELITY_MEMORY
  storageLocation: gs://${BUCKET_NAME}/benchmark-workloads/sleep/
