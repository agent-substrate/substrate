# Generic ActorTemplate for every SWE-perf task in images.json.
# benchmarking/workloads/deploy.sh renders one copy per requested
# sweperf-<repo>-<id> template, filling the SWEPERF_* values from that
# task's images.json entry.
metadata:
  atespace: benchmark-workloads
  name: ${SWEPERF_NAME}
workerSelector:
  matchLabels:
    workload: benchmark-ateom
containers:
- name: ${SWEPERF_CONTAINER}
  # Task image from https://github.com/gke-labs/sweperf, which supplies both
  # the replay server and the trajectory under test, pinned by digest: these
  # images are commonly rebuilt in place under the same tag.
  #
  # Images must be built from sweperf c30c0d6 (2026-09-21) or later: older
  # images have no HTTP execution API and fail on the client's first
  # GET /status. generate.py writes the replay server to /replay.py and the
  # trajectory to /trace.json at the image root.
  image: "${SWEPERF_IMAGE}"
  command:
  - "python3"
  - "/replay.py"
  - "/trace.json"
  env:
  - name: SWEPERF_DISABLE_INTERNAL_SLEEP
    value: "1"
  # The trajectory's step count. The replay server ignores it; the boomer
  # sweperf client reads it back with GetActorTemplate to partition the trace
  # into cycles.
  - name: SWEPERF_TOTAL_STEPS
    value: "${SWEPERF_STEPS}"
sandboxConfig:
  sandboxClass: ${SANDBOX_CLASS_ENUM}
  configName: ${SANDBOX_CONFIG_NAME}
snapshotConfig:
  onPause: SNAPSHOT_CONTENT_SCOPE_FULL
  onCommit: SNAPSHOT_CONTENT_SCOPE_FULL
  storageLocation: gs://${BUCKET_NAME}/benchmark-workloads/${SWEPERF_NAME}/
