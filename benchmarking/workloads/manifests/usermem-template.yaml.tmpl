# ActorTemplate (protojson-shaped ateapipb.ActorTemplate) for the usermem
# benchmark workload (locust/tests/usermem.py): stress holds 1 GiB of user
# memory to size memory snapshots. Not part of deploy.sh's default template
# set; deploy with WORKLOAD_TEMPLATES="usermem ...". No memory limit: the
# workload allocates 1 GiB, well above the 256Mi default --actor-memory the
# other templates take. The sandbox class must match the WorkerPool's so
# snapshots stay within a class.
metadata:
  atespace: benchmark-workloads
  name: usermem
workerSelector:
  matchLabels:
    workload: benchmark-ateom
containers:
- name: usermem
  image: containerstack/alpine-stress:latest
  command: ["stress", "--vm", "1", "--vm-bytes", "1G", "--vm-keep", "--vm-hang", "0"]
snapshotsConfig:
  onPause: SNAPSHOT_CONTENT_SCOPE_FULL
  onCommit: SNAPSHOT_CONTENT_SCOPE_FULL
  storageLocation: gs://${BUCKET_NAME}/benchmark-workloads/usermem/
sandboxConfig:
  sandboxClass: ${SANDBOX_CLASS_ENUM}
  configName: ${SANDBOX_CONFIG_NAME}
