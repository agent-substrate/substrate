# Worker pool for the Nighthawk egress traffic-driver actor. The ActorTemplate
# is a substrate resource, not a CRD: it lives in
# traffic-driver-template.yaml.tmpl and is created through the ate API with
# `kubectl-ate create actor-template`.

apiVersion: v1
kind: Namespace
metadata:
  name: nighthawk

---

apiVersion: ate.dev/v1alpha1
kind: WorkerPool
metadata:
  name: traffic-driver
  namespace: nighthawk
  labels:
    workload: traffic-driver
spec:
  replicas: 1
  workerImage: ko://github.com/agent-substrate/substrate/cmd/ateom-gvisor
  sandboxClasses:
  - name: gvisor
