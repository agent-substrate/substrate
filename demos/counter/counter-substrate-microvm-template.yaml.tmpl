# Substrate ActorTemplate resource (protojson-shaped ateapipb.ActorTemplate,
# NOT the ate.dev/v1alpha1 CRD) for the micro-VM counter demo. Applied with
# `kubectl ate create actor-template -f -` after `ko resolve` replaces the
# ko:// image reference; the ate-demo-counter-substrate-microvm atespace must
# exist.
metadata:
  atespace: ate-demo-counter-substrate-microvm
  name: counter-microvm
workerSelector:
  matchLabels:
    workload: counter-substrate-microvm
containers:
- name: counter
  image: ko://github.com/agent-substrate/substrate/demos/counter
  command:
  - /ko-app/counter
  # Second listener for atenet-router's arbitrary-port ingress, kept in step
  # with the CRD variant in counter-microvm.yaml.tmpl.
  - --extra-port=9090
  readyz:
    httpGet:
      path: /readyz
      port: 80
    # Guest boots stretch badly under CI contention; see the rationale in
    # counter-microvm.yaml.tmpl.
    timeoutSeconds: 120
  volumeMounts:
  - name: data
    mountPath: /home/counter
# Sandbox size: vCPUs + guest RAM at (or below) the pool's per-worker
# capacity, leaving VMM-reserve headroom under the worker memory limit
# (see internal/sizing). Quantities are strings in the proto.
resources:
  limits:
  - name: cpu
    quantity: "2"
  - name: memory
    quantity: 512Mi
snapshotsConfig:
  # FULL on both triggers so a suspend captures guest memory and the
  # in-memory count continues across suspend/resume.
  onPause: SNAPSHOT_CONTENT_SCOPE_FULL
  onCommit: SNAPSHOT_CONTENT_SCOPE_FULL
  storageLocation: gs://${BUCKET_NAME}/ate-demo-counter-substrate-microvm/
sandboxConfig:
  sandboxClass: SANDBOX_CLASS_MICROVM
  configName: microvm
volumes:
- name: data
  type: DurableDir
  durableDir: {}
