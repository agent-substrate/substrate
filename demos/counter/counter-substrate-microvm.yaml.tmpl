# Worker pool for the micro-VM (kata + cloud-hypervisor) substrate-resource
# variant of the counter demo. The ActorTemplate is not a CRD here: it lives
# in counter-substrate-microvm-template.yaml.tmpl and is created through the
# ate API with `kubectl ate create actor-template`. The cluster-wide `microvm`
# SandboxConfig referenced by the pool is installed by
# hack/install-microvm-deps.sh

apiVersion: v1
kind: Namespace
metadata:
  name: ate-demo-counter-substrate-microvm

---

apiVersion: ate.dev/v1alpha1
kind: WorkerPool
metadata:
  name: counter-substrate-microvm
  namespace: ate-demo-counter-substrate-microvm
  labels:
    workload: counter-substrate-microvm
spec:
  # Two workers: one for the demo actor, one spare for the golden actor the
  # template reconciler runs while building the golden snapshot.
  replicas: 2
  sandboxClass: microvm
  sandboxConfigName: microvm
  ateomImage: ko://github.com/agent-substrate/substrate/cmd/ateom-microvm
  template:
    # Per-worker resources; the micro-VM sandbox is sized by the ActorTemplate's
    # resources, which must leave VMM-reserve headroom under this memory limit
    # (see internal/sizing and counter-microvm.yaml.tmpl for the rationale).
    resources:
      limits:
        cpu: "2"
        memory: 2Gi
      requests:
        cpu: 500m
        memory: 2Gi
