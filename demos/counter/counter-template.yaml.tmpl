# ActorTemplate (protojson-shaped ateapipb.ActorTemplate) for the counter
# demo. Applied with `kubectl ate create actor-template -f -` after
# `ko resolve` replaces the ko:// image reference; the ate-demo-counter
# atespace must exist.
#
# The ${...}_ARG/MOUNTS/VOLUMES placeholder lines are dropped on a plain
# deploy and filled in by --deploy-demo-counter-with-external-volume.
metadata:
  atespace: ate-demo-counter
  name: counter
workerSelector:
  matchLabels:
    workload: counter
containers:
- name: counter
  image: ko://github.com/agent-substrate/substrate/demos/counter
  command:
  - /ko-app/counter
  # Exercises atenet-router's arbitrary-port ingress support: a second
  # listener a test can address by CONNECTing to <actor-dns>:9090, distinct
  # from the primary port 80 every other assertion in this demo uses.
  - --extra-port=9090
  - --tcp-port=9091
${VALIDATE_EXISTING_FILE_PATH_ARG}
  readyz:
    httpGet:
      path: /readyz
      port: 80
  volumeMounts:
  - name: data
    mountPath: /home/counter
${EXTERNAL_VOLUME_MOUNTS}
# Sandbox size: an actor occupies its whole worker, so size it at (or below)
# the pool's per-worker capacity (see counter.yaml.tmpl and internal/sizing).
# Quantities are strings in the proto.
resources:
  limits:
  - name: cpu
    quantity: "1"
  - name: memory
    quantity: 512Mi
snapshotsConfig:
  onPause: SNAPSHOT_CONTENT_SCOPE_FULL
  # FULL, so a suspend captures process memory as well as the durable
  # volumes and the tutorial's in-memory counter really does continue
  # across suspend/resume. DATA-scope behavior (durable volumes only,
  # memory cold-boots) is exercised by the e2e demo suite's own
  # parameterized templates, not by this one.
  onCommit: SNAPSHOT_CONTENT_SCOPE_FULL
  storageLocation: gs://${BUCKET_NAME}/ate-demo-counter/
sandboxConfig:
  sandboxClass: SANDBOX_CLASS_GVISOR
  configName: gvisor-default
volumes:
- name: data
  type: DurableDir
  durableDir: {}
${EXTERNAL_VOLUMES}
