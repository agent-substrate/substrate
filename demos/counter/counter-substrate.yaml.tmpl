# Worker pool for the substrate-resource variant of the counter demo. The
# ActorTemplate itself is not a CRD here: it lives in counter-substrate-template.yaml.tmpl
# and is created through the ate API with `kubectl ate create actor-template`.

apiVersion: v1
kind: Namespace
metadata:
  name: ate-demo-counter-substrate

---

apiVersion: ate.dev/v1alpha1
kind: WorkerPool
metadata:
  name: counter-substrate
  namespace: ate-demo-counter-substrate
  labels:
    workload: counter-substrate
spec:
  # Two workers: one for the demo actor, one spare for the golden actor the
  # template reconciler runs while building the golden snapshot.
  replicas: 2
  workerImage: ko://github.com/agent-substrate/substrate/cmd/ateom-gvisor
  template:
    # Per-worker resources; the sandbox itself is sized by the ActorTemplate's
    # resources (see internal/sizing and counter.yaml.tmpl for the rationale).
    resources:
      limits:
        cpu: "1"
        memory: 1Gi
      requests:
        cpu: 250m
        memory: 1Gi
