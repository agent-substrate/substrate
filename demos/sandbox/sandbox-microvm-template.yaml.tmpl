# ActorTemplate (protojson-shaped ateapipb.ActorTemplate) for the micro-VM
# sandbox demo. Applied with `kubectl ate create actor-template -f -` after
# `ko resolve` replaces the ko:// image reference; the
# ate-demo-sandbox-microvm atespace must exist.
metadata:
  atespace: ate-demo-sandbox-microvm
  name: sandbox-microvm
workerSelector:
  matchLabels:
    workload: sandbox-microvm
containers:
- name: sandbox
  image: ko://github.com/agent-substrate/substrate/demos/sandbox
  env:
  - name: PORT
    value: "80"
# Sandbox size: vCPUs + guest RAM at (or below) the pool's per-worker capacity,
# leaving VMM-reserve headroom under the worker memory limit (see
# internal/sizing). Quantities are strings in the proto.
resources:
  limits:
  - name: cpu
    quantity: "1"
  - name: memory
    quantity: 512Mi
snapshotConfig:
  # MEMORY, matching the gVisor variant: the sandbox preserves live process
  # state across a suspend, so a resume continues the same shell session.
  preferredFidelity: SNAPSHOT_FIDELITY_MEMORY
  storageLocation: gs://${BUCKET_NAME}/ate-demo-sandbox-microvm/
sandboxConfig:
  sandboxClass: SANDBOX_CLASS_MICROVM
  configName: microvm
