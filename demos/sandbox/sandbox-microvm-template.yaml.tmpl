# ActorTemplate (protojson-shaped ateapi.ActorTemplate) for the micro-VM
# sandbox demo. Applied with `kubectl ate create actor-template -f -` after
# `ko resolve` replaces the ko:// image reference; the
# ate-demo-sandbox-microvm atespace must exist.
metadata:
  atespace: ate-demo-sandbox-microvm
  name: sandbox-microvm
workerSelector:
  matchLabels:
    workload: sandbox-microvm
containers:
- name: sandbox
  image: ko://go.ate.dev/substrate/demos/sandbox
  env:
  - name: PORT
    value: "80"
# Sandbox size: vCPUs + guest RAM, which with the microVM overhead has to
# fit the pool's per-worker capacity (see sandbox-microvm.yaml.tmpl and
# internal/sizing).
resources:
  limits:
    cpuMillicores: 1000
    memoryBytes: 536870912 # 512Mi
snapshotConfig:
  # MEMORY, matching the gVisor variant: the sandbox preserves live process
  # state across a suspend, so a resume continues the same shell session.
  preferredFidelity: SNAPSHOT_FIDELITY_MEMORY
