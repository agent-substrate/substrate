# ActorTemplate (protojson-shaped ateapipb.ActorTemplate) for the
# autoscaled-workerpool demo. Applied with
# `kubectl ate create actor-template -f -` after `ko resolve` replaces the
# ko:// image reference; the ate-demo-autoscaled-workerpool atespace must
# exist.
metadata:
  atespace: ate-demo-autoscaled-workerpool
  name: counter
workerSelector:
  matchLabels:
    workload: counter-autoscaled
containers:
- name: counter
  image: ko://github.com/agent-substrate/substrate/demos/counter
  command:
  - /ko-app/counter
  readyz:
    httpGet:
      path: /readyz
      port: 80
  volumeMounts:
  - name: data
    mountPath: /home/counter
snapshotsConfig:
  onPause: SNAPSHOT_CONTENT_SCOPE_FULL
  onCommit: SNAPSHOT_CONTENT_SCOPE_DATA
  storageLocation: gs://${BUCKET_NAME}/ate-demo-autoscaled-workerpool/
sandboxConfig:
  sandboxClass: SANDBOX_CLASS_GVISOR
  configName: gvisor-default
volumes:
- name: data
  type: DurableDir
  durableDir: {}
