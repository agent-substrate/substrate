# This demo shows that two ActorTemplates running two different binaries can
# share a single WorkerPool, even from different atespaces. A WorkerPool is
# image-agnostic capacity (its pods only run the ateom supervisor); each
# ActorTemplate carries its own workload image and gates on the pool via
# workerSelector, a label selector matched against the pool's labels (no
# atespace or namespace scoping involved: pool selection is cluster-wide).
# The "counter" and "fspersist" templates each sit in their own atespace
# (counter-template.yaml.tmpl, fspersist-template.yaml.tmpl) and both select
# this one "shared-pool" via the same workload label.

apiVersion: v1
kind: Namespace
metadata:
  name: ate-demo-multi-template-pool
---
apiVersion: ate.dev/v1alpha1
kind: WorkerPool
metadata:
  name: shared-pool
  namespace: ate-demo-multi-template-pool
  labels:
    workload: multi-template-shared
spec:
  replicas: 3
  workerImage: ko://github.com/agent-substrate/substrate/cmd/ateom-gvisor
