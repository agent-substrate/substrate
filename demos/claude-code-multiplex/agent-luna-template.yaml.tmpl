# ActorTemplate (protojson-shaped ateapi.ActorTemplate) for the luna agent
# of the claude-code-multiplex demo; one of three agents sharing the 2-pod
# pool in claude-code-multiplex.yaml.tmpl. Applied with
# `kubectl ate create actor-template -f -`; the claude-multiplex-demo
# atespace must exist.
#
# WORKLOAD_IMAGE is the resolved sha256-digest reference for the
# claude-multiplex-demo-workload image, built and pushed to ${KO_DOCKER_REPO}
# by the deploy step and substituted at apply time.
#
# ANTHROPIC_API_KEY is set to a non-secret placeholder so the golden snapshot
# never stores credentials. At runtime, atenet-egress replaces the x-api-key
# header on requests to api.anthropic.com with the value from the
# anthropic-api-key Secret via k8s-credential-provider.
metadata:
  atespace: claude-multiplex-demo
  name: agent-luna
workerSelector:
  matchLabels:
    workload: claude-multiplex
containers:
- name: claude
  image: ${WORKLOAD_IMAGE}
  env:
  - name: ACTOR_NAME
    value: "luna"
  - name: TASK
    value: "Tell me one short, surprising fact about the Moon. One sentence."
  - name: INTERVAL_SECONDS
    value: "8"
  - name: ANTHROPIC_API_KEY
    value: "egress-injected"
  - name: NODE_EXTRA_CA_CERTS
    value: /run/ate/egress-trust-bundle/trust-bundle.pem
  - name: SSL_CERT_FILE
    value: /run/ate/egress-trust-bundle/trust-bundle.pem
  volumeMounts:
  - name: system-info
    mountPath: /run/ate
volumes:
- name: system-info
  systemInfo:
    dataSources:
    - trustBundle:
        names:
        - egress-mitm.ate.dev
        - system-roots.ate.dev
        path: egress-trust-bundle/trust-bundle.pem
# Sandbox size: Claude Code on Node uses several hundred MB and spikes while
# running tools.
resources:
  limits:
    cpuMillicores: 1000
    memoryBytes: 2147483648 # 2Gi
snapshotConfig:
  preferredFidelity: SNAPSHOT_FIDELITY_MEMORY
