# ActorTemplate (protojson-shaped ateapipb.ActorTemplate) for the orion
# agent of the claude-code-multiplex demo; see agent-luna-template.yaml.tmpl
# for the placeholder and apply conventions.
metadata:
  atespace: claude-multiplex-demo
  name: agent-orion
workerSelector:
  matchLabels:
    workload: claude-multiplex
containers:
- name: claude
  image: ${WORKLOAD_IMAGE}
  env:
  - name: ACTOR_NAME
    value: "orion"
  - name: TASK
    value: "Suggest one healthy meal that takes under 15 minutes to prepare. One sentence."
  - name: INTERVAL_SECONDS
    value: "45"
  - name: ANTHROPIC_API_KEY
    value: "${ANTHROPIC_API_KEY}"
snapshotsConfig:
  onPause: SNAPSHOT_CONTENT_SCOPE_FULL
  onCommit: SNAPSHOT_CONTENT_SCOPE_FULL
  storageLocation: gs://${BUCKET_NAME}/claude-multiplex-demo/
sandboxConfig:
  sandboxClass: SANDBOX_CLASS_GVISOR
  configName: gvisor-default
