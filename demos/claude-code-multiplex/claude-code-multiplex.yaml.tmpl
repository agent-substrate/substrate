# Worker pool for the claude-code-multiplex demo. The three agent
# ActorTemplates live in agent-*-template.yaml.tmpl and are created through
# the ate API with `kubectl ate create actor-template`; sharing a 2-pod pool
# between 3 agents is the multiplex pressure that makes the substrate
# suspend/resume behavior visible.

apiVersion: v1
kind: Namespace
metadata:
  name: claude-multiplex-demo

---

apiVersion: ate.dev/v1
kind: WorkerPool
metadata:
  name: claude-workerpool
  namespace: claude-multiplex-demo
  labels:
    workload: claude-multiplex
spec:
  replicas: 2
  workerImage: ko://go.ate.dev/substrate/cmd/ateworker-gvisor
  template:
    # One worker holding one actor: the limits are what it advertises as
    # capacity. The CPU limit matches one agent template's 1 CPU, so the 2-pod
    # pool can host at most 2 running agents at once. The memory limit is above
    # the agent's 2Gi because the worker keeps some of it for itself, and the
    # request equals it because memory is not compressible.
    resources:
      limits:
        cpu: "1"
        memory: 2560Mi
      requests:
        cpu: 250m
        memory: 2560Mi
  sandboxClasses:
  - name: gvisor
