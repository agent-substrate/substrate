{
  "globalFlags": [
    "-log-format",
    "json",
    "--alsologtostderr",
    "--allow-suid",
    "--host-settings=ignore"
  ],
  "commands": {
    "create": {
      "globalFlags": [
        "--cpu-num-from-quota",
        "-debug-log=/dev/fd/3",
        "-debug-command=create,start,restore",
        "-alsologtostderr=false"
      ]
    },
    "start": {
      "globalFlags": [
        "-allow-connected-on-save",
        "-debug-log=/dev/fd/3",
        "-debug-command=create,start,restore",
        "-alsologtostderr=false"
      ]
    },
    "restore": {
      "globalFlags": [
        "--cpu-num-from-quota",
        "-debug-log=/dev/fd/3",
        "-debug-command=create,start,restore",
        "-alsologtostderr=false"
      ],
      "subcommandFlags": [
        "-background",
        "-detach"
      ]
    },
    "delete": {
      "subcommandFlags": [
        "-force"
      ]
    },
    "list": {
      "subcommandFlags": [
        "-quiet"
      ]
    }
  }
}
