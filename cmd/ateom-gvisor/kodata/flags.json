{
  "globalFlags": [
    "-log-format",
    "json",
    "--alsologtostderr",
    "--enable-core-tags",
    "--allow-suid",
    "--host-settings=ignore"
  ],
  "commands": {
    "create": {
      "globalFlags": [
        "--cpu-num-from-quota"
      ]
    },
    "start": {
      "globalFlags": [
        "-allow-connected-on-save"
      ]
    },
    "restore": {
      "globalFlags": [
        "--cpu-num-from-quota"
      ],
      "subcommandFlags": [
        "-background",
        "-detach"
      ]
    },
    "delete": {
      "subcommandFlags": [
        "-force"
      ]
    },
    "list": {
      "subcommandFlags": [
        "-quiet"
      ]
    }
  }
}
